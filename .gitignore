# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试与覆盖率 ----
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ---- 编辑器与 IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
*.tmp
_tmp_*
~$*
# artifacts 下的 .log 是契约交付物（index.json 注册并校验 SHA-256）
!e2-a03/artifacts/**/*.log

# ---- 本地环境变量（可能含密钥） ----
.env
.env.local
*.local

# ---- 构建产物与镜像导出 ----
*.tar
*.tar.gz
out/
# 注意：e2-a03/artifacts/ 是契约交付物（含 index.json 与产物 SHA-256），
# 必须纳入版本控制，不要忽略。Minicalc 的编译发生在它自己的仓库，
# 不在本仓库内，因此这里不写 *.o / *.exe / minicalc 等规则。

