{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/b-group/task.schema.json",
  "title": "E2 A/B 配对组契约草案 1.0",
  "$defs": {
    "repository": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "url",
        "commit"
      ],
      "additionalProperties": false
    },
    "build": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "clean_command": {
          "type": "string",
          "minLength": 1
        },
        "verify_command": {
          "type": "string",
          "minLength": 1
        },
        "working_directory": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "command",
        "clean_command",
        "verify_command",
        "working_directory"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1
        },
        "configuration_id": {
          "type": "string",
          "minLength": 1
        },
        "project_root": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "image",
        "configuration_id",
        "project_root"
      ],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "timeout_seconds"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "INPUT_1001",
            "INPUT_1002",
            "INPUT_1003",
            "INPUT_1004",
            "ARTIFACT_2001",
            "ENV_3002",
            "EXEC_4002",
            "ANALYSIS_5001",
            "REPAIR_6001"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "exit_code": {
